
class Solution {
    public int[] singleNum(int[] arr) {
        // Code here
        int val[]=new int[2];
         int k=0;
         HashMap<Integer,Integer> hm=new HashMap<>();
        for(int i=0;i<arr.length;i++){
            hm.put(arr[i],hm.getOrDefault(arr[i],0)+1);
        }
        for(int i=0;i<arr.length;i++){
            if(hm.get(arr[i])==1){
                val[k]=arr[i];
                k++;
                if(k==2 && val[0]>val[1]){
                        int temp=val[0];
                        val[0]=val[1];
                        val[1]=temp;
                    
                }
            }
        }
        return val;
        
    }
}


